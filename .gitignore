# claude
.claude/settings.local.json
.claude/scheduled_tasks.lock

# dependencies
/node_modules

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*.local

# working files
!tmp/.gitkeep
tmp/*

# generated build artifacts
.generated/
/public/search-index.json
# RELEASE_ID = 短縮git SHA + 日付。コミット毎に必ずドリフトするため追跡しない。
# prebuild/predev/pretest/pretypecheck の generate:release-id で常に再生成される
# （デプロイは npm run build → prebuild で再生成＝本番の値は正しい）。
src/lib/generated/release-id.ts

# playwright MCP logs
.playwright-mcp/

# typescript
*.tsbuildinfo
next-env.d.ts

# 画像ファイルはリポジトリ肥大化防止のためコミット禁止。
# 公開目的で画像ファイルが必要な場合は、公開用の public ディレクトリを作って
# そのディレクトリだけ ignore から除外する（!public/ など）形で許可してもよい。
*.jpg
*.png

# ブログ記事に埋め込む公開画像は追跡対象にする（記事本文から参照するため）。
!public/blog/
!public/blog/*.png
# アイコン判定計器(scripts/icon-metrics.ts)の較正 fixture。
# これが追跡外だと clone 先でテストが落ち、「機械の歯止め」が存在しなくなる（cycle-302 で実際に発生）。
!scripts/__tests__/fixtures/*.png

# Python bytecode cache
__pycache__/
